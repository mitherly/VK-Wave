{
  "name": "vk-wave",
  "productName": "VK Wave",
  "version": "1.1.0",
  "description": "Десктопный клиент VK Музыки с Discord Rich Presence, медиа-клавишами и системным треем",
  "main": "main.js",
  "author": {
    "name": "mitherly",
    "url": "https://github.com/mitherly"
  },
  "license": "MIT",
  "homepage": "https://github.com/mitherly/VK-Wave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitherly/VK-Wave.git"
  },
  "bugs": {
    "url": "https://github.com/mitherly/VK-Wave/issues"
  },
  "keywords": [
    "vk",
    "music",
    "vk-music",
    "discord",
    "rich-presence",
    "discord-rpc",
    "electron",
    "tray"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "upload:assets": "node tools/upload-discord-assets.js"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.vkwave.desktop",
    "productName": "VK Wave",
    "copyright": "Copyright © 2026 mitherly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "discord.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VK Wave"
    },
    "linux": {
      "icon": "assets/logo.png",
      "category": "Audio",
      "target": ["AppImage"]
    },
    "mac": {
      "icon": "assets/logo.png",
      "category": "public.app-category.music",
      "target": ["dmg"]
    }
  }
}
